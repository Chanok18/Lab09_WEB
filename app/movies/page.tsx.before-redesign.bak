import Link from "next/link";
import { Clapperboard, Sparkles } from "lucide-react";
import { getMovieById } from "@/lib/omdb";
import FeaturedMovies from "@/components/movies/FeaturedMovies";
import MovieExplorer from "@/components/movies/MovieExplorer";

export const dynamic = "force-dynamic";

const featuredIds = [
  "tt0816692",
  "tt1375666",
  "tt0468569",
  "tt0133093",
  "tt0111161",
  "tt4154796",
  "tt0110912",
  "tt7286456",
];

export default async function MoviesPage() {
  const results = await Promise.allSettled(
    featuredIds.map((id) => getMovieById(id))
  );

  const movies = results.flatMap((result) =>
    result.status === "fulfilled" && result.value
      ? [result.value]
      : []
  );

  return (
    <main className="min-h-screen bg-[#080b16] text-white">
      <header className="sticky top-0 z-40 border-b border-white/10 bg-[#080b16]/95 backdrop-blur-xl">
        <div className="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 md:px-10">
          <Link href="/movies" className="flex items-center gap-3">
            <span className="rounded-xl bg-gradient-to-br from-violet-500 to-fuchsia-600 p-2.5 shadow-lg shadow-violet-900/40">
              <Clapperboard size={24} />
            </span>
            <span className="text-2xl font-black tracking-tight">
              Cine<span className="text-violet-400">Verse</span>
            </span>
          </Link>

          <nav className="hidden items-center gap-8 text-sm font-medium text-slate-300 md:flex">
            <a href="#inicio" className="hover:text-white">Inicio</a>
            <a href="#peliculas" className="hover:text-white">Películas</a>
            <a href="#buscar" className="hover:text-white">Buscar</a>
          </nav>

          <a
            href="#buscar"
            className="flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-2 text-xs font-semibold text-violet-300 hover:bg-violet-500/20"
          >
            <Sparkles size={15} />
            Explorar
          </a>
        </div>
      </header>

      <MovieExplorer />

      <FeaturedMovies movies={movies} />

      <footer className="border-t border-white/10 px-5 py-8 text-center text-sm text-slate-500">
        CineVerse · Galería de películas y series · Next.js + OMDb API
      </footer>
    </main>
  );
}
